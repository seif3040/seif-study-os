{
  "framework": "vite",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__seif_api_path=:path*"
    },
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/index?__seif_storage_path=:path*"
    },
    {
      "source": "/((?!api/|manus-storage/|assets/|__manus__/|manifest[.]webmanifest$|study-logo[.]svg$|study-icon-[0-9]+[.]png$|study-worker[.]js$).*)",
      "destination": "/index.html"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Seif Study OS · متابعة الدروس",
  "version": "0.1.9",
  "description": "احفظ مكانك ووقت مشاهدتك على منصات المدرسين.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://seif-study-os.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "متابعة الدروس"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seif-study-os.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}

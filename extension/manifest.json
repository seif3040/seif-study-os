{
  "manifest_version": 3,
  "name": "Seif Study OS · متابعة الدروس",
  "version": "0.1.4",
  "description": "احفظ مكانك ووقت مشاهدتك على منصات المدرسين.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seif-study-os.vercel.app/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ]
}
